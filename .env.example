# Copier ce fichier en ".env" à la racine de app/ et renseigner les vraies
# valeurs (Supabase Dashboard > Project Settings > API).
# Ne JAMAIS committer le fichier ".env" réel (déjà ignoré par .gitignore).
# Ne JAMAIS mettre ici une clé "secret" ou "service_role".
# La clé publishable est la seule clé prévue pour l'application mobile.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
